# Bagholder runtime data lives in ~/.bagholder, never in the repo.
# These entries guard against copies ever landing inside the project.
.bagholder/
session.json
*.db
*.db-wal
*.db-shm
bagholder.db
client_id
user_agent
chrome/
ext/

# Xcode regenerates these per machine: the workspace stub, and window state under a user's own name
ios/**/project.xcworkspace/
**/xcuserdata/

# OS / editor cruft
.DS_Store
._*
__MACOSX/
*.swp
*~
.idea/
.vscode/

# the built app and the release assets
/bagholder
/bagholder.exe
/bagholder-v*
/dist/

.claude/

# the compose data folder: the database and the login
data/

# Python bytecode from the reference sources, while they are still in the tree
__pycache__/
*.pyc
