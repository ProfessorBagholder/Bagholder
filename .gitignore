# Bagholder runtime data lives in ~/.bagholder, never in the repo.
# These entries guard against copies ever landing inside the project.
.bagholder/
session.json
*.db
*.db-wal
*.db-shm
bagholder.db
client_id
user_agent
chrome/
ext/

# Xcode regenerates these per machine: the workspace stub, and window state under a user's own name
ios/**/project.xcworkspace/
**/xcuserdata/

# OS / editor cruft
.DS_Store
._*
__MACOSX/
*.swp
*~
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Rust build output
rust/target/
.claude/

# the compose data folder: the database and the login
data/

# brought in from the root by `go generate ./...`; the tracked copy is the root one
go/ledger.html
go/lightweight-charts.js
go/favicon.png
