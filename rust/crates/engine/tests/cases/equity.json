[
  {
    "name": "Bagholder's own value: cash plus holdings at their close; returns net of the money moved in",
    "spec": "docs/architecture.md §8: equity is Bagholder's own, from the record, prices and FX; SPEC.md §2: returns net of deposits and withdrawals",
    "working": [
      "Jan 5: 1,000 deposited → value 1,000 (a flow)",
      "Jan 6: 10 X bought for 500, X closes at 50 → 500 + 500 = 1,000, return (1,000 − 0) ÷ 1,000 − 1 = 0",
      "Jan 7: X closes at 55 → 500 + 550 = 1,050, return 0.05",
      "Jan 8 (today): X's quote 56 → 1,060"
    ],
    "today": "2026-01-08",
    "accounts": [{"id": "A"}],
    "instruments": [{"id": "X"}],
    "closes": {"X": {"2026-01-06": "50", "2026-01-07": "55"}},
    "quotes": {"X": {"price": "56"}},
    "transactions": [
      {"id": "t1", "account": "A", "day": "2026-01-05", "at": "2026-01-05T15:00:00Z", "kind": "deposit", "cash": "1000"},
      {"id": "t2", "account": "A", "day": "2026-01-06", "at": "2026-01-06T15:00:00Z", "kind": "buy", "instrument": "X", "qty": "10", "cash": "-500"}
    ],
    "expect": {"equity": [
      {"account": "A", "day": "2026-01-05", "value": "1000", "source": "own"},
      {"account": "A", "day": "2026-01-06", "value": "1000", "source": "own", "return": 0.0},
      {"account": "A", "day": "2026-01-07", "value": "1050", "source": "own", "return": 0.05},
      {"account": "A", "day": "2026-01-08", "value": "1060", "source": "own"}
    ]}
  },
  {
    "name": "a weekend takes the last session's close; an asset moved in is a flow at its value that day",
    "spec": "docs/plans/stage-2-engine.md, the equity series",
    "working": [
      "Fri Jan 9: 10 X transferred in, X closes at 20 → value 200, a flow of 200",
      "Sat Jan 10: no close, the last within the week is Friday's 20 → 200, return 0",
      "Mon Jan 12: X closes at 22 → 220, return 0.1"
    ],
    "today": "2026-01-13",
    "accounts": [{"id": "A"}],
    "instruments": [{"id": "X"}],
    "closes": {"X": {"2026-01-09": "20", "2026-01-12": "22", "2026-01-13": "22"}},
    "quotes": {"X": {"price": "22"}},
    "transactions": [{"id": "t1", "account": "A", "day": "2026-01-09", "at": "2026-01-09T15:00:00Z", "kind": "transfer-in", "instrument": "X", "qty": "10"}],
    "expect": {"equity": [
      {"account": "A", "day": "2026-01-09", "value": "200", "source": "own"},
      {"account": "A", "day": "2026-01-10", "value": "200", "source": "own", "return": 0.0},
      {"account": "A", "day": "2026-01-12", "value": "220", "source": "own", "return": 0.1}
    ]}
  },
  {
    "name": "a problem on a record leaves the account's own value waiting from its day; the broker's stated value stands there",
    "spec": "docs/plans/stage-2-engine.md, the equity series: any problem on a record of that account on or before that day; the broker's net value for it, marked as the broker's",
    "working": [
      "Jan 5: 1,000 deposited; Jan 6: own value 1,000",
      "Jan 7: a row the mapping could not place: from then the own value waits (record-problem)",
      "the broker states 1,010 on Jan 7 and 1,020 on Jan 8 with net deposits 1,000 both days: Jan 8's return is 1,020 ÷ 1,010 − 1"
    ],
    "today": "2026-01-08",
    "accounts": [{"id": "A"}],
    "transactions": [
      {"id": "t1", "account": "A", "day": "2026-01-05", "at": "2026-01-05T15:00:00Z", "kind": "deposit", "cash": "1000"},
      {"id": "t2", "account": "A", "day": "2026-01-07", "at": "2026-01-07T15:00:00Z", "kind": "unclassified", "problems": ["unclassified"]}
    ],
    "brokers": {"A": {"net_value": {"2026-01-07": "1010", "2026-01-08": "1020"}, "net_deposits": {"2026-01-07": "1000", "2026-01-08": "1000"}}},
    "expect": {"equity": [
      {"account": "A", "day": "2026-01-06", "value": "1000", "source": "own"},
      {"account": "A", "day": "2026-01-07", "value": "1010", "source": "broker", "own_gaps": ["record-problem"]},
      {"account": "A", "day": "2026-01-08", "value": "1020", "source": "broker", "return": 0.009900990099009901}
    ]}
  },
  {
